{
  "info": {
    "name": "Smart Garden IoT Management System",
    "description": "Postman Collection for Smart Garden IoT System featuring Authentication, Garden Management, Vegetable Stocking, Price Tracking, Revenue Analysis, and MQTT/WebSocket IoT Telemetry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "gardenId", "value": "" },
    { "key": "vegetableId", "value": "" },
    { "key": "priceId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health & Auth",
      "item": [
        {
          "name": "GET /hello",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/hello", "host": ["{{baseUrl}}"], "path": ["hello"] }
          }
        },
        {
          "name": "POST /auth/register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Garden Admin\",\n  \"email\": \"admin@garden.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save token for later requests",
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('accessToken', res.access_token);",
                  "}",
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@garden.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Gardens",
      "item": [
        {
          "name": "POST /gardens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the created garden ID",
                  "const res = pm.response.json();",
                  "if (res.id) { pm.collectionVariables.set('gardenId', res.id); }",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Greenhouse Garden A\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/gardens", "host": ["{{baseUrl}}"], "path": ["gardens"] }
          }
        },
        {
          "name": "GET /gardens",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/gardens", "host": ["{{baseUrl}}"], "path": ["gardens"] }
          }
        },
        {
          "name": "GET /gardens/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}"]
            }
          }
        },
        {
          "name": "PUT /gardens/:id",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Greenhouse Garden A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}"]
            }
          }
        },
        {
          "name": "DELETE /gardens/:id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Vegetables",
      "item": [
        {
          "name": "POST /gardens/:gardenId/vegetables",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the created vegetable ID",
                  "const res = pm.response.json();",
                  "if (res.id) { pm.collectionVariables.set('vegetableId', res.id); }",
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomato\",\n  \"importQty\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}/vegetables",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}", "vegetables"]
            }
          }
        },
        {
          "name": "GET /gardens/:gardenId/vegetables",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}/vegetables",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}", "vegetables"]
            }
          }
        },
        {
          "name": "PUT /gardens/:gardenId/vegetables/:vegetableId",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"importQty\": 150,\n  \"soldQty\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}/vegetables/{{vegetableId}}",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}", "vegetables", "{{vegetableId}}"]
            }
          }
        },
        {
          "name": "POST /gardens/:gardenId/vegetables/:vegetableId/price",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 25000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}/vegetables/{{vegetableId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}", "vegetables", "{{vegetableId}}", "price"]
            }
          }
        },
        {
          "name": "PUT /gardens/:gardenId/vegetables/:vegetableId/price",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 28000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}/vegetables/{{vegetableId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}", "vegetables", "{{vegetableId}}", "price"]
            }
          }
        },
        {
          "name": "GET /gardens/:gardenId/vegetables/:vegetableId/price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}/vegetables/{{vegetableId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}", "vegetables", "{{vegetableId}}", "price"]
            }
          }
        },
        {
          "name": "DELETE /gardens/:gardenId/vegetables/:vegetableId/price",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gardens/{{gardenId}}/vegetables/{{vegetableId}}/price",
              "host": ["{{baseUrl}}"],
              "path": ["gardens", "{{gardenId}}", "vegetables", "{{vegetableId}}", "price"]
            }
          }
        }
      ]
    },
    {
      "name": "Price & Revenue",
      "item": [
        {
          "name": "GET /price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/price?period=day",
              "host": ["{{baseUrl}}"],
              "path": ["price"],
              "query": [{ "key": "period", "value": "day" }]
            }
          }
        },
        {
          "name": "GET /all/price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/all/price?period=month",
              "host": ["{{baseUrl}}"],
              "path": ["all", "price"],
              "query": [{ "key": "period", "value": "month" }]
            }
          }
        }
      ]
    },
    {
      "name": "IoT & Telemetry",
      "item": [
        {
          "name": "POST /device/command",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gardenId\": 1,\n  \"userId\": 1,\n  \"led1State\": \"On\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/device/command",
              "host": ["{{baseUrl}}"],
              "path": ["device", "command"]
            }
          }
        }
      ]
    }
  ]
}
